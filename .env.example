# SimplePDF Comprehensive Production & Development Environment Configuration

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# HORIZONTAL SCALING & PROCESS CLUSTERING
# -----------------------------------------------------------------------------
CLUSTER_MODE=false
MAX_WORKERS=0 # 0 = Auto-detect based on host RAM and CPU core constraints

# -----------------------------------------------------------------------------
# SECURITY & NETWORKING
# -----------------------------------------------------------------------------
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://simplepdf.me,https://www.simplepdf.me
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_ACCESS_EXPIRY=86400 # 24 Hours in seconds
RATE_LIMIT_WINDOW_MS=60000 # 1 Minute window
RATE_LIMIT_MAX_REQUESTS=500 # 500 requests per minute
JOB_RATE_LIMIT_MAX=60 # 60 heavy conversion uploads per minute

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/simplepdf
DB_POOL_MIN=2
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# DISTRIBUTED JOB QUEUE (Redis & BullMQ)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://:password@localhost:6379/0
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# WORKER CONCURRENCY & BACKPRESSURE
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=4 # Simultaneous PDF processing operations per worker
QUEUE_MAX_WAITING_JOBS=100 # Maximum allowed queued jobs before shedding load (503)
JOB_TIMEOUT_MS=180000 # 3 minutes max conversion time limit

# -----------------------------------------------------------------------------
# STORAGE ABSTRACTION (Local, AWS S3, or Cloudflare R2)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local # local | s3 | r2
TEMP_FILE_TTL_MINUTES=60
MAX_FILE_SIZE_MB_FREE=50
MAX_FILE_SIZE_MB_PRO=200

# S3 / Cloudflare R2 Storage Credentials (Required if STORAGE_DRIVER is s3 or r2)
STORAGE_S3_BUCKET=simplepdf-documents
STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY=your_access_key_id
# STORAGE_S3_SECRET_KEY=your_secret_access_key
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# PAYMENT & WEBHOOKS
# -----------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=whsec_replace_with_live_webhook_secret_key

# -----------------------------------------------------------------------------
# FRONTEND MONETIZATION & ANALYTICS (Vite Environment)
# -----------------------------------------------------------------------------
VITE_SITE_URL=https://simplepdf.me
VITE_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GSC_VERIFICATION=google-site-verification-placeholder
